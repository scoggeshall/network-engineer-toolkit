{
  "name": "network-engineer-toolkit",
  "displayName": "Network Engineer Toolkit",
  "description": "Local and remote network engineering tools for Visual Studio Code.",
  "version": "0.1.0",
  "publisher": "scoggeshall",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:networkEngineerToolkit.analyzeSubnet",
    "onCommand:networkEngineerToolkit.discoverSwitchport",
    "onCommand:networkEngineerToolkit.remoteDnsLookup"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "networkEngineerToolkit.analyzeSubnet",
        "title": "Network Tools: Analyze IP/Subnet"
      },
      {
        "command": "networkEngineerToolkit.discoverSwitchport",
        "title": "Network Tools: Discover Switchport"
      },
      {
        "command": "networkEngineerToolkit.remoteDnsLookup",
        "title": "Network Tools: DNS Lookup from Lab Server"
      }
    ],
    "configuration": {
      "title": "Network Engineer Toolkit",
      "properties": {
        "networkEngineerToolkit.backendUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL of the Network Engineer Toolkit backend used for remote tools."
        },
        "networkEngineerToolkit.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional Python 3 executable used by the local Switchport Discovery helper during development."
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "tsc -p tsconfig.json",
    "test": "npm run clean && npm run compile && node --test out/test/*.test.js",
    "test:helper": "python -m unittest discover -s helper/test -v"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.9.0"
  }
}
