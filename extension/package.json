{
  "name": "network-engineer-toolkit",
  "displayName": "Network Engineer Toolkit",
  "description": "Local network engineering tools for Visual Studio Code.",
  "version": "0.1.1",
  "publisher": "scoggeshall",
  "icon": "assets/pyscout.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/scoggeshall/network-engineer-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/scoggeshall/network-engineer-toolkit/issues"
  },
  "homepage": "https://github.com/scoggeshall/network-engineer-toolkit#readme",
  "keywords": [
    "networking",
    "network-engineering",
    "dns",
    "subnet",
    "lldp",
    "cdp"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "networkEngineerToolkit.analyzeSubnet",
        "title": "Network Tools: Analyze IP/Subnet"
      },
      {
        "command": "networkEngineerToolkit.discoverSwitchport",
        "title": "Network Tools: Discover Switchport"
      },
      {
        "command": "networkEngineerToolkit.dnsLookup",
        "title": "Network Tools: DNS Lookup"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "networkEngineerToolkit",
          "title": "Network Engineer Toolkit",
          "icon": "assets/pyscout-activity.svg"
        }
      ]
    },
    "views": {
      "networkEngineerToolkit": [
        {
          "id": "networkEngineerToolkit.tools",
          "name": "Tools",
          "icon": "assets/pyscout-activity.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "networkEngineerToolkit.tools",
        "contents": "NETWORK ENGINEER TOOLKIT\nNetwork Tools\n[Analyze IP/Subnet](command:networkEngineerToolkit.analyzeSubnet)\n[DNS Lookup](command:networkEngineerToolkit.dnsLookup)\n[Discover Switchport](command:networkEngineerToolkit.discoverSwitchport)"
      }
    ],
    "configuration": {
      "title": "Network Engineer Toolkit",
      "properties": {
        "networkEngineerToolkit.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional Python 3 executable used by the local Switchport Discovery helper during development."
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "tsc -p tsconfig.json",
    "compile:production": "npm run clean && tsc -p tsconfig.production.json",
    "vscode:prepublish": "npm run compile:production",
    "package:prepare": "node -e \"require('node:fs').mkdirSync('dist', { recursive: true })\"",
    "package": "npm run package:prepare && vsce package --out dist",
    "test": "npm run clean && npm run compile && node --test out/test/*.test.js",
    "test:helper": "python -m unittest discover -s helper/test -v"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "^5.9.0"
  }
}
